# Copy this file to .env (never commit .env).

# Gemini — plan / judge / write / YouTube watch. Free key:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Tavily — default web search (free Researcher plan, 1,000 credits/month, no card):
# https://app.tavily.com
TAVILY_API_KEY=your-tavily-key-here

# Optional. Default is gemini-3.5-flash-lite (works on new free-tier keys).
# gemini-2.5-* returns 404 for new users even though models.list() still shows them.
# MEMENTO_MODEL=gemini-3.5-flash-lite

# Optional comma-separated fallbacks used on 404 / 503. Default: gemini-3.8-flash
# MEMENTO_FALLBACK_MODELS=gemini-3.8-flash

# Search backend. Default: tavily (free). gemini = Google Search grounding (needs billing).
# MEMENTO_SEARCH_PROVIDER=tavily

# Only used when MEMENTO_SEARCH_PROVIDER=gemini.
# MEMENTO_SEARCH_MODEL=gemini-3.5-flash-lite

# Max YouTube videos Gemini will watch per run (free tier: 8 hours of YouTube/day).
# MEMENTO_MAX_VIDEOS=2

# Optional. Default: %USERPROFILE%\.memento\memento.db on Windows,
# ~/.memento/memento.db on Linux/macOS.
# MEMENTO_DB_PATH=C:\Users\you\.memento\memento.db
