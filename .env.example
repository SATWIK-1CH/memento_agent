# Copy this file to .env (never commit .env).
# Get a free key at https://aistudio.google.com/apikey

GEMINI_API_KEY=your-key-here

# Optional. Default is gemini-2.5-flash (free-tier Google Search grounding).
# MEMENTO_MODEL=gemini-2.5-flash

# Optional. Defaults to MEMENTO_MODEL. Use this to keep search on 2.5 Flash
# (free grounding) while reasoning on a newer Gemini 3.x model (tokens free,
# but Grounding with Google Search is paid-only on Gemini 3+).
# MEMENTO_SEARCH_MODEL=gemini-2.5-flash

# Optional. Default: %USERPROFILE%\.memento\memento.db on Windows,
# ~/.memento/memento.db on Linux/macOS.
# MEMENTO_DB_PATH=C:\Users\you\.memento\memento.db
